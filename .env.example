# ============================================================================
# VEIN Backend — 로컬 환경변수 템플릿
#   cp .env.example .env   후 값을 채운다. .env 는 커밋 금지(.gitignore 처리됨).
#   docker compose 와 Spring Boot 가 동일한 DB_* 값을 공유한다.
# ============================================================================

# --- Database (docker-compose + Spring 공용) ---------------------------------
DB_NAME=vein
DB_USERNAME=vein
# 아무 값이나. 로컬 전용 컨테이너지만 커밋하지 않는다.
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/vein

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost

# --- JWT (필수) ---------------------------------------------------------------
# HS256 서명키. 32바이트 이상. 미설정 시 애플리케이션 기동 실패.
#   생성: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- Web Push / VAPID (선택) --------------------------------------------------
# 비우면 web push 기능만 비활성화되고 나머지는 정상 동작한다.
#   생성: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@vein.local
WEB_PUSH_TTL_SEC=3600

# --- 시드 관리자 계정 (V22) ----------------------------------------------------
# V5__seed.sql 이 만드는 tester 계정의 비밀번호. V22 마이그레이션이 해시를 회전시키므로
# 여기에 적어둔 평문이 실제 로그인 비밀번호가 된다(참고용 기록 — 앱이 읽지는 않는다).
SEED_ADMIN_EMAIL=tester@vein.local
SEED_ADMIN_PASSWORD=

# --- Python 사이드카 (미국/한국 주식 · 텔레그램 · 틱띄기) ------------------------
# 미기동 시 백엔드가 합성 스텁으로 폴백한다.
SIDECAR_URL=http://localhost:8099

# --- 수집 스케줄러 스위치 -------------------------------------------------------
INGESTION_ENABLED=false
LIQUIDATION_ENABLED=false
SCALP_ENABLED=false
